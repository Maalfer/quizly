# ─── Quizly · configuración ────────────────────────────────────────────────
# Copia este fichero a `.env` y ajusta los valores.
#   cp .env.example .env

# Clave para firmar las cookies de sesión. GENERA UNA PROPIA:
#   python -c "import secrets; print(secrets.token_hex(32))"
QUIZLY_SECRET=cambia-esta-clave-por-una-aleatoria

# ─── Base de datos (MariaDB / MySQL) ────────────────────────────────────────
# Con Docker Compose usa el nombre del servicio: MYSQL_HOST=db
# Sin Docker (app en local contra una BD local): MYSQL_HOST=127.0.0.1
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=quizly
MYSQL_PASSWORD=cambia-esta-password
MYSQL_DB=quizly

# Contraseña de root de MariaDB (solo la usa el contenedor de la BD)
MYSQL_ROOT_PASSWORD=cambia-esta-root-password

# ─── IA (opcional) ──────────────────────────────────────────────────────────
# Activa la generación de quizzes con Claude. Si se deja vacío, la función
# simplemente queda desactivada en la interfaz.
# ANTHROPIC_API_KEY=sk-ant-...
QUIZLY_AI_MODEL=claude-sonnet-4-6
